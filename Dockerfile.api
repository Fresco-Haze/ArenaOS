# ---- build ----
FROM haskell:9.6.7 AS build
WORKDIR /src

# The library uses `hs-source-dirs: .`, so cabal needs the real sources even to
# build dependencies. Copy only what the API needs, so edits to web/, scripts/,
# docs and tests don't invalidate the slow dependency layer.
COPY arenaos.cabal cabal.project cabal.project.freeze ./
COPY Application ./Application/
COPY Domain ./Domain/
COPY Engine ./Engine/
COPY Shell ./Shell/
COPY api ./api/
COPY app ./app/

RUN cabal update && cabal build --only-dependencies exe:arenaos-api exe:arenaos
RUN cabal build exe:arenaos-api exe:arenaos

# Collect the binary and every shared lib it needs except the libc family.
RUN mkdir -p /out/lib \
 && cp "$(cabal list-bin exe:arenaos-api)" /out/arenaos-api \
 && cp "$(cabal list-bin exe:arenaos)" /out/arenaos \
 && strip /out/arenaos-api /out/arenaos \
 && ldd /out/arenaos-api /out/arenaos \
    | awk '/=> \//{print $3}' \
    | grep -Ev '/(libc|libm|libdl|libpthread|librt|libutil|libresolv)\.so' \
    | xargs -r -I{} cp -L {} /out/lib/

# ---- runtime ----
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends sqlite3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin arenaos \
 && mkdir -p /data \
 && chown arenaos:arenaos /data

COPY --from=build /out/arenaos-api /usr/local/bin/arenaos-api
COPY --from=build /out/arenaos /usr/local/bin/arenaos
COPY --from=build /out/lib/ /usr/local/lib/arenaos/

ENV LD_LIBRARY_PATH=/usr/local/lib/arenaos \
    ARENAOS_DB=/data/arenaos.db \
    PORT=3000 \
    ARENAOS_HOST=0.0.0.0 \
    ARENAOS_TRUST_PROXY=1

# Fail the build now, not at runtime, if a shared library is missing.
RUN if ldd /usr/local/bin/arenaos-api /usr/local/bin/arenaos | grep -q 'not found'; then \
      ldd /usr/local/bin/arenaos-api /usr/local/bin/arenaos; exit 1; \
    fi

USER arenaos
VOLUME /data
EXPOSE 3000
CMD ["arenaos-api"]